# Copy to .env for local use. .env is gitignored and must never be committed.
# Better still, skip this file entirely and use the standard HuggingFace location:
#   huggingface-cli login      -> writes ~/.cache/huggingface/token (chmod 600)
#
# Only needed to verify the 4 gated entries. Everything else works anonymously.
# The token must be a READ token AND you must accept each dataset's terms on its
# HuggingFace page - a token alone does not grant access to a gated repo.
HF_TOKEN=
